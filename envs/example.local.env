# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
ENV=local
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db (Docker 실행: DB_HOST=mysql / 로컬 직접 실행: DB_HOST=localhost)
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=pw1234
DB_ROOT_PASSWORD=Password123@!
DB_NAME=ai_health

# redis (Docker 실행: REDIS_HOST=redis / 로컬 직접 실행: REDIS_HOST=localhost)
REDIS_HOST=redis
REDIS_PORT=6379
