# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
ENV=local
APP_VERSION=v1.0.0
SECRET_KEY=your-jwt-secret-key-here
# 비워 두면 host-only 쿠키다. 하위 도메인끼리 나눠 쓸 때만 채운다
COOKIE_DOMAIN=
# 서버 벽시계 시간대. 기본값 Asia/Seoul 을 쓰려면 줄을 주석으로 둔다
# (ZoneInfo 라 빈 문자열·잘못된 이름은 기동 시 파싱 오류).
# TIMEZONE=Asia/Seoul

# 환자 링크 절대 URL의 앞부분 — KEY-297. 끝에 슬래시(/) 없이.
PATIENT_WEB_BASE_URL=http://localhost

# jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ai-worker
AI_WORKER_VERSION=v1.0.0
# 프런트를 구운 nginx 이미지 태그 (KEY-189). 로컬 compose 는 `./frontend` 를
# 바인드 마운트해서 안 쓰지만, **이름은 보여 준다** — 이 파일을 베껴 운영으로
# 갈 때 그런 설정이 있다는 걸 알아야 한다 (KEY-195).
WEB_VERSION=

# db (Docker 실행: DB_HOST=mysql / 로컬 직접 실행: DB_HOST=localhost)
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=your-db-password
DB_ROOT_PASSWORD=your-db-root-password
DB_NAME=ai_health

# redis (Docker 실행: REDIS_HOST=redis / 로컬 직접 실행: REDIS_HOST=localhost)
REDIS_HOST=redis
REDIS_PORT=6379
# 운영 compose 는 호스트 포트를 따로 받는다 (KEY-193). 로컬 compose 는
# 아직 `6379:6379` 로 박아 두었지만, 예시가 이름을 보여 주는 편이 낫다.
REDIS_EXPOSE_PORT=

# 논리 DB 번호(0~15). 평소엔 안 채운다 — 기본값 0. pytest-xdist 로 검사를
# 병렬 실행할 때 워커별로 겹치지 않게 나누는 용도다 (`app/tests/conftest.py`).
# REDIS_DB=


# CLOVA OCR (KEY-56) — 비운 채 큐에 들어간 판독 작업은 Worker가
# OCR_NOT_CONFIGURED 로 실패시킨다(fixture 로 자동 대체되지 않음). 워커·CLOVA
# 없이 흐름을 보려면 아래 OCR_FIXTURE_FALLBACK=true.
# 실제 키는 절대 코드·로그·커밋에 남기지 않는다.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
CLOVA_OCR_TIMEOUT_SECONDS=10

# 업로드 — 아래 둘은 형이 있는 칸이다. 빈 문자열을 넣으면 pydantic 이 int 로
# 파싱하다 죽으므로, 기본값(임시 경로 · 20MB)을 쓰려면 줄을 주석으로 둔다.
# bootstrap-local.sh 는 실제 값으로 채워 넣는다.
# UPLOAD_DIR=
# MAX_UPLOAD_SIZE_MB=

# 로컬 전용 스위치(bool). true 면 FastAPI 업로드 경로가 합성 판독값을 바로 넣고
# 워커 큐잉을 건너뛴다. prod 에서 켜면 서버가 뜨지 않는다. 기본값(false)을
# 쓰려면 줄을 주석으로 둔다 — 빈 문자열은 파싱 오류다.
# OCR_FIXTURE_FALLBACK=

# OpenAI — 환자 챗봇 응답 생성에 쓴다 (서버에서는 app/apis/v1/chatbot_routers.py
# 하나가 읽는다. scripts/key96_live_smoke.py 도 환경변수로 읽는다).
# 안내문 생성에는 안 쓰인다 (LLM 생성 미착수, KEY-75).
#
# ⚠ OPENAI_API_KEY 는 None 일 때만 LLM 호출이 꺼진다. `OPENAI_API_KEY=` 처럼
# 빈 값을 두면 SecretStr('') 이 되어 is not None 이 참 → 모델 객체가 만들어지고,
# 챗봇 질문마다 호출을 시도하다 예외가 난다. 관측에는 `model_failed` 로 남아
# **설정을 안 한 것과 구분되지 않는다.** 끄려면 줄을 주석으로 둔다
# (example.prod.env 와 동일). 실제 키는 코드·로그·커밋에 남기지 않는다.
#
# (질문이 밖으로 새지는 않는다 — 빈 키면 헤더가 `Bearer ` 가 되어 h11 이 불법
#  헤더 값으로 거부하고 직렬화 단계에서 죽는다. 바이트가 0 이다. 전에 이 자리에
#  「환자 질문 원문이 api.openai.com 으로 나간다」고 적혀 있었는데 사실이
#  아니었다 — KEY-308.)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

# MinIO — 합성 EMR 이미지 보관 (KEY-191). S3 호환이라 Sprint 6 AWS 전환 때
# 엔드포인트만 바꾼다. 로컬은 아무 값이나 넣어도 되지만 **비워 두면 컨테이너가
# 안 뜬다** (MinIO 가 거부한다). 비밀번호는 8자 이상이어야 한다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
KNOWLEDGE_MINIO_ENDPOINT=http://minio:9000
KNOWLEDGE_MINIO_BUCKET=approved-knowledge
# 안 적으면 9000·9001 을 쓴다.
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# local·dev·test 전용 고정 OTP (KEY-219). 비우면 mock 어댑터가 "발송 수단
# 없음"으로 막혀 환자 OTP 인증(시연 3-6)이 503 으로 멈춘다. 시연하려면
# 000000 을 넣는다. prod 에서는 이 값만으로 열리지 않는다 — `PILOT_ALLOW_MOCK_OTP=1`
# 과 `--pilot-confirm-mock-otp` 가 **둘 다** 있어야 좁은문이 열린다
# (`app/core/config.py` 의 `pilot_mock_otp_gate_open()`, `app/pilot_server.py`).
# MOCK_OTP_CODE=

# ---------- 문자 발송 (KEY-248) ----------
# 자격증명 없이 동작하는 mock이 기본값이다. 실제 발송을 확인할 때만 solapi로 바꾼다.
SMS_PROVIDER=mock
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
SOLAPI_BASE_URL=https://api.solapi.com
SOLAPI_TIMEOUT_SECONDS=10

# ---------- 환자 OTP 실발송 (KEY-284) ----------
# SMS_PROVIDER=solapi로 실제 발송을 켤 때만 의미가 있다. 쉼표로 구분한
# 전화번호 원문 — 이 목록에 있는 번호로만 실제 OTP가 나간다. 운영 활성화
# 승인(KEY-6) 전까지는 prod든 아니든 항상 이 목록을 본다. **비워 두면
# 전부 막힌다** — 좁은문을 열면서 이걸 안 채우면 공급자 장애와 똑같이
# 보이는 503만 받는다(원인 찾기 오래 걸린다는 걸 리뷰로 실제 재현했다).
OTP_APPROVED_TEST_PHONES=
# prod에서 실제 OTP 발송을 켜려면 이 환경변수 **와** 실행 시 CLI 플래그
# --otp-confirm-solapi-prod 를 함께 넣어야 한다(KEY-6 배포 승인 뒤에만).
OTP_SOLAPI_PROD_ENABLED=

# 만드는 중 — 대표 처방·약 이름을 고치고 지울 수 있다
CATALOG_DRAFT_MODE=true
