# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
ENV=local
APP_VERSION=v1.0.0
SECRET_KEY=your-jwt-secret-key-here
COOKIE_DOMAIN=localhost

# jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db (Docker 실행: DB_HOST=mysql / 로컬 직접 실행: DB_HOST=localhost)
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=your-db-password
DB_ROOT_PASSWORD=your-db-root-password
DB_NAME=ai_health

# redis (Docker 실행: REDIS_HOST=redis / 로컬 직접 실행: REDIS_HOST=localhost)
REDIS_HOST=redis
REDIS_PORT=6379

# CLOVA OCR (KEY-56) — 비워 두면 분류 결과만 반환, 채우면 실제 OCR 호출
# NAVER Cloud Console → CLOVA OCR → General API → 도메인 URL과 Secret Key를 여기에 입력
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
CLOVA_OCR_TIMEOUT_SECONDS=30
