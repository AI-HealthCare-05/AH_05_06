# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
#
# SECRET_KEY 는 **반드시 채운다.** 안 채우면 서버가 이름을 대며 멈춘다
# (KEY-174). 기본값은 프로세스마다 달라서, 재배포할 때마다 발급한 토큰이
# 전부 죽는다 — 「갑자기 로그아웃됐다」로 보인다.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
ENV=prod
APP_VERSION=v1.0.0
SECRET_KEY=your-jwt-secret-key-here
# 비워 두면 host-only 쿠키다. 하위 도메인끼리 나눠 쓸 때만 채운다
COOKIE_DOMAIN=

# jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ai-worker
AI_WORKER_VERSION=v1.0.0

# 프런트를 구운 nginx 이미지 태그 (KEY-189). 되돌릴 때 이 값을 내린다.
WEB_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=your-db-password
DB_ROOT_PASSWORD=your-db-root-password
DB_NAME=ai_health

# redis
REDIS_HOST=redis
REDIS_PORT=6379

# 업로드 — 컨테이너 안 경로다. compose 의 볼륨과 같은 자리를 가리켜야
# 재시작해도 파일이 남는다.
UPLOAD_DIR=/vol/web/media
MAX_UPLOAD_SIZE_MB=20

# 시간대·템플릿. **정수 칸은 비워 두면 안 된다** — 빈 문자열은 pydantic 의
# int 검증에서 막혀 서버가 아예 안 뜬다. 기본값을 그대로 적어 둔다 (KEY-174).
TIMEZONE=Asia/Seoul
TEMPLATE_DIR=

# DB 연결 — 아래는 기본값 그대로다. 망이 느린 곳에서만 손댄다.
DB_CONNECT_TIMEOUT=5
DB_CONNECTION_POOL_MAXSIZE=10

# JWT 시계 오차 허용치(초). 서버 시계가 어긋난 환경에서만 손댄다.
JWT_LEEWAY=5

# ⚠ OCR_FIXTURE_FALLBACK 은 **운영에 두지 않는다.** 로컬 전용이고, prod 에서
# 켜면 서버가 뜨지 않는다(`config.py` 의 검증기). 합성 판독 결과를 진짜처럼
# 내보내는 스위치라 운영에 있으면 안 된다.
#
# OCR_FIXTURE_FALLBACK=

# ---------- 챗봇 LLM (KEY-96) ----------
# 아래 셋은 기본값 그대로다. 다른 모델·게이트웨이를 쓸 때만 손댄다.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20.0

# ⚠ 아래 셋은 **빈 값으로 두지 않는다.** 줄을 아예 두지 않거나, 값을 채운다.
#
#   OPENAI_API_KEY 는 `None` 일 때만 LLM 호출이 꺼진다
#   (`chatbot_routers.py:18` 의 `is not None`). 빈 값은 `SecretStr("")` 이라
#   **켜진 채 빈 키로 호출**해 요청마다 인증 오류가 난다.
#
#   LLM_*_USD_PER_1M_TOKENS 는 `float` 이라 빈 값이면 서버가 아예 안 뜬다.
#   단가를 넣은 경우에만 추정 비용을 기록한다.
#
# OPENAI_API_KEY=
# LLM_INPUT_USD_PER_1M_TOKENS=
# LLM_OUTPUT_USD_PER_1M_TOKENS=

# ---------- CLOVA OCR (KEY-56) ----------
# 둘 다 채워야 판독이 돈다. **비워 두면 워커가 모든 건을 실패로 끝낸다** —
# `OCR_FIXTURE_FALLBACK` 이 운영에서 금지라 합성 결과로 되메우지 않는다
# (`ai_worker/tasks/ocr_task.py`). 조용히 넘어가지 않게 한 것이다.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=

# 초 단위. 비워 두면 `float` 검증에서 막혀 서버가 안 뜬다.
CLOVA_OCR_TIMEOUT_SECONDS=10
