# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
ENV=prod
APP_VERSION=v1.0.0
SECRET_KEY=your-jwt-secret-key-here
# 비워 두면 host-only 쿠키다. 하위 도메인끼리 나눠 쓸 때만 채운다
COOKIE_DOMAIN=

# jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=your-db-password
DB_ROOT_PASSWORD=your-db-root-password
DB_NAME=ai_health

# redis
REDIS_HOST=redis
REDIS_PORT=6379
