Ref: prescription_check_item.prescription_set_id > prescription_set.prescription_set_id
Ref: prescription_set_drug.prescription_set_id > prescription_set.prescription_set_id
Ref: medical_document.visit_id > visit.visit_id
Ref: patient_feedback.guide_document_id > guide_document.guide_document_id
Ref: knowledge_chunk.version_id > knowledge_version.version_id
Ref: knowledge_ingestion_attempt.version_id > knowledge_version.version_id
Ref: knowledge_version.document_id > knowledge_document.document_id
Ref: ocr_document_text.ocr_result_id > ocr_result.ocr_result_id
Ref: ocr_field.ocr_result_id > ocr_result.ocr_result_id
Ref: ocr_field_candidate.ocr_field_id > ocr_field.ocr_field_id
Ref: ocr_job.visit_id > visit.visit_id
Ref: ocr_job_document.ocr_job_id > ocr_job.ocr_job_id
Ref: ocr_result.ocr_job_id - ocr_job.ocr_job_id
Ref: prescription.visit_id - visit.visit_id
Ref: prescription_item.prescription_id > prescription.prescription_id
Ref: hospital_update_event.actor_staff_id > staff.staff_id
Ref: hospital_update_event.hospital_id > hospital.hospital_id
Ref: staff.hospital_id > hospital.hospital_id
Ref: staff_account_event.actor_staff_id > staff.staff_id
Ref: staff_account_event.hospital_id > hospital.hospital_id
Ref: staff_account_event.subject_staff_id > staff.staff_id
Ref: chatbot_submission.guide_document_id > guide_document.guide_document_id
Ref: check_in.guide_document_id - guide_document.guide_document_id
Ref: check_in_signal.guide_document_id > guide_document.guide_document_id
Ref: check_in_signal_acknowledgement.state_id > check_in_signal_state.state_id
Ref: check_in_signal_state.guide_document_id - guide_document.guide_document_id
Ref: check_in_signal_state.signal_id > check_in_signal.signal_id
Ref: guide_document.visit_id - visit.visit_id
Ref: guide_event.guide_document_id > guide_document.guide_document_id
Ref: guide_message.guide_document_id > guide_document.guide_document_id
Ref: guide_message_event.guide_message_id > guide_message.guide_message_id
Ref: guide_message_setting.guide_document_id > guide_document.guide_document_id
Ref: guide_safety_check.generation_job_id > guide_generation_job.job_id
Ref: guide_safety_check.guide_document_id > guide_document.guide_document_id
Ref: guide_section.drug_caution_content_id > drug_caution_content.drug_caution_content_id
Ref: guide_section.guide_document_id > guide_document.guide_document_id
Ref: guide_section_source_snapshot.guide_document_id > guide_document.guide_document_id
Ref: guide_section_source_snapshot.guide_section_id > guide_section.guide_section_id
Ref: patient_guide_link.guide_document_id - guide_document.guide_document_id
Ref: patient_otp_challenge.patient_guide_link_id - patient_guide_link.patient_guide_link_id
Ref: patient_usage_event.guide_document_id > guide_document.guide_document_id
Ref: visit.patient_id > patient.patient_id
Ref: visit_check_answer.visit_id > visit.visit_id
